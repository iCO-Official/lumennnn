# --- Supabase (database + auth) ---
# Public values: shipped to the browser. If unset, the app falls back to the
# existing project hardcoded in vite.config.ts.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only. Only needed by code that uses the admin client (bypasses RLS).
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# Google Gemini by default. Free key: https://aistudio.google.com/apikey
AI_API_KEY=
# AI_MODEL=gemini-flash-latest
# Any other OpenAI-compatible API also works, e.g. Groq:
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=llama-3.3-70b-versatile
