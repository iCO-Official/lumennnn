# --- Supabase (database + auth) ---
# Public values: shipped to the browser. If unset, the app falls back to the
# existing project hardcoded in vite.config.ts.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only. Only needed by code that uses the admin client (bypasses RLS).
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI (any OpenAI-compatible Chat Completions API) ---
AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4.1-mini
# Example for Google Gemini:
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_MODEL=gemini-2.5-flash
